{% extends 'base.html.twig' %}

{% block title %}User Profile{% endblock %}

{% block body %}
<section id="profile-page">
    <div class="container">
        <div class="row">
            <div class="col-md-10 m-auto">
                <h1 class="fw-bolder" style="color: limegreen;">Profile</h1>

                <p class="fs-3"><strong style="color: limegreen;">Email:</strong> {{ user.email }}</p>

                <h3 style="color: limegreen;">Preferences:</h3>
                <twig:ProfileForm :profile="user.volunteerProfile"/>

                <h3 class="mt-4" style="color: limegreen;">Your matches:</h3>
                <ol class="list-group list-group-numbered mb-5">
                    {% for conference in matches %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="{{ path('app_conference_show', {id: conference.id}) }}"
                               class="text-decoration-none fw-semibold"
                               style="color: limegreen;">{{ conference.name }}</a>
                            <span>{{ conference.startAt|date('d/m/y') }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item">No matches yet, save your preferences to look for some.</li>
                    {% endfor %}
                </ol>
            </div>
        </div>
    </div>
</section>
{% endblock %}
